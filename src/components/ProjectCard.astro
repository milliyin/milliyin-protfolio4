---
import type { CollectionEntry } from "astro:content";

interface Props {
    project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
---

<article>
    <a class="card" href={"/projects/" + project.id}>
        <h4 class="card-title">{project.data.title}</h4>
        <p class="card-copy faded no-underline">
            {project.data.description.length > 110
                ? `${project.data.description.slice(0, 107).trim()}...`
                : project.data.description}
        </p>
    </a>
</article>
