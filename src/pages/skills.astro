---
import SkillCard from "@components/SkillCard.astro";
import { getCollection } from "astro:content";
import ListLayout from "@layouts/list.astro";
import { site } from "@/site";

const unsortedSkills = await getCollection("skills");

const skills = unsortedSkills.sort((a, b) => a.data.id - b.data.id);
---

<ListLayout
    title={`${site.name} | Skills`}
    description={site.sections.skills}
    contentType="Skills"
>
    <header>
        <h1>Skills And Tools</h1>
        <p>{site.sections.skills}</p>
    </header>

    <section class="space-y-4">
        <h2 class="pt-0">Tools And Tech</h2>
        <ul class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {
                skills.map((skill) => (
                    <li>
                        <SkillCard skill={skill} />
                    </li>
                ))
            }
        </ul>
    </section>
</ListLayout>
