---
import ContentLayout from "@layouts/content.astro";
import TableOfContents from "@components/TableOfContents.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
    const allPosts = await getCollection("posts");

    return allPosts.map((post) => ({
        params: { slug: post.id },
        props: { post }
    }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const publishedLabel = post.data.createdAt.toLocaleDateString("en-US", {
    month: "long",
    day: "numeric",
    year: "numeric"
});
---

<ContentLayout
    contentType="Blogs"
    contentPath="/blog/"
    title={post.data.title}
    description={post.data.description}
    ogImage={post.data.heroImage}
    createdAt={post.data.createdAt}
    updatedAt={post.data.updatedAt ?? post.data.createdAt}
    wide={true}
>
    <header class="space-y-4">
        <h1>{post.data.title}</h1>
        <div class="meta-row">
            <time class="meta-link" datetime={post.data.createdAt.toISOString()}>
                <svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M8 2v4" />
                    <path d="M16 2v4" />
                    <rect width="18" height="18" x="3" y="4" rx="2" />
                    <path d="M3 10h18" />
                </svg>
                {publishedLabel}
            </time>
            <button class="share-link" type="button" data-share-url={Astro.url.pathname}>
                <svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M4 12v7a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-7" />
                    <path d="M12 16V3" />
                    <path d="M8 7l4-4 4 4" />
                </svg>
                Share Blog
            </button>
        </div>
    </header>
    <TableOfContents headings={headings} />
    <article class:list={["space-y-6 content", post.id === "why-vercel-uses-app-not-com" && "case-study"]}>
        <Content />
    </article>
    <dialog class="image-lightbox" data-image-lightbox aria-label="Expanded image view">
        <button class="image-lightbox-close" type="button" data-image-lightbox-close aria-label="Close expanded image">
            Close
        </button>
        <img data-image-lightbox-image alt="" />
    </dialog>
    <script is:inline>
        const shareButton = document.querySelector("[data-share-url]");
        if (shareButton instanceof HTMLButtonElement) {
            shareButton.addEventListener("click", async () => {
                const shareUrl = new URL(
                    shareButton.dataset.shareUrl || window.location.pathname,
                    window.location.origin
                ).toString();

                if (navigator.share) {
                    try {
                        await navigator.share({
                            title: document.title,
                            url: shareUrl
                        });
                        return;
                    } catch {}
                }

                try {
                    await navigator.clipboard.writeText(shareUrl);
                    shareButton.textContent = "Link Copied";
                    window.setTimeout(() => {
                        shareButton.textContent = "Share Blog";
                    }, 1600);
                } catch {
                    window.prompt("Copy this link:", shareUrl);
                }
            });
        }

        const setupImageLightbox = () => {
            const lightbox = document.querySelector("[data-image-lightbox]");
            const expandedImage = lightbox?.querySelector("[data-image-lightbox-image]");
            const closeButton = lightbox?.querySelector("[data-image-lightbox-close]");

            if (!(lightbox instanceof HTMLDialogElement) || !(expandedImage instanceof HTMLImageElement)) return;

            document.querySelectorAll("article.content img").forEach((image) => {
                if (!(image instanceof HTMLImageElement) || image.dataset.lightboxReady) return;

                image.dataset.lightboxReady = "true";
                image.tabIndex = 0;
                image.setAttribute("role", "button");
                image.setAttribute("aria-label", `${image.alt || "Article image"}. Open full-size view`);

                const openImage = () => {
                    expandedImage.src = image.currentSrc || image.src;
                    expandedImage.alt = image.alt;
                    lightbox.showModal();
                };

                image.addEventListener("click", openImage);
                image.addEventListener("keydown", (event) => {
                    if (event.key === "Enter" || event.key === " ") {
                        event.preventDefault();
                        openImage();
                    }
                });
            });

            if (!lightbox.dataset.controlsReady) {
                lightbox.dataset.controlsReady = "true";
                closeButton?.addEventListener("click", () => lightbox.close());
                lightbox.addEventListener("click", (event) => {
                    if (event.target === lightbox) lightbox.close();
                });
                lightbox.addEventListener("close", () => {
                    expandedImage.removeAttribute("src");
                    expandedImage.alt = "";
                });
            }
        };

        setupImageLightbox();
        document.addEventListener("astro:page-load", setupImageLightbox);
    </script>
</ContentLayout>
